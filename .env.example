NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# PostgreSQL (PostGIS etkin olmalı)
DATABASE_URL=postgres://duraknet:duraknet@localhost:5433/duraknet

# Redis 6.2+ (GEOSEARCH için; cluster modu değil)
REDIS_URL=redis://localhost:6380

# Auth: her biri en az 32 karakter, birbirinden farklı. Üretmek için:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Tek yönetici hesabı. Hash üretmek için: pnpm --filter @duraknet/api hash-password
# Hash $ karakterleri içerir: docker compose env_file veya shell export ile verirken TEK TIRNAK içine alın.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Artırılınca tüm yönetici oturumları düşer
ADMIN_TOKEN_VERSION=0

# Yük dengeleyici arkasında: önündeki proxy sayısı (ör. 1) veya güvenilen adresler. Doğrudan açık node: false
TRUST_PROXY=false
# Virgülle ayrılmış izinli origin listesi. '*' yalnızca geliştirmede; üretimde zorunlu.
CORS_ORIGINS=*

# ===== Worker =====
# Bu süredir konum göndermeyen (aktif işi olmayan) şoför GEO'dan çıkarılır ve offline yapılır (ms).
HEARTBEAT_STALE_MS=60000
# Heartbeat sweeper tarama aralığı (ms). En kötü durumda GEO'dan çıkış ≈ HEARTBEAT_STALE_MS + SWEEP_EVERY_MS
# (varsayılanlarla 70 sn; Faz 2 kabul sınırı 75 sn).
SWEEP_EVERY_MS=10000
# Dispatch / hatırlatma / yakındaki araçlar / uzlaştırıcı (Faz 3). Worker de DATABASE_URL ister (yukarıda).
# Dalga 1, 2, 3 sonrası bekleme (sn, virgüllü); sonraki dalgalar (sürekli tarama) DISPATCH_SCAN_EVERY_S ile süresiz sürer.
DISPATCH_WAVE_DELAYS_S=20,20,30
DISPATCH_SCAN_EVERY_S=30
# `ride_still_open` hatırlatması yalnızca bildirimdir; çağrıyı iptal etmez. İlk hatırlatma API'de (REMINDER_FIRST_SEC),
# sonrakiler worker'da bu aralıkla (sn). Worker uzlaştırıcıda hatırlatmayı yeniden kurarken REMINDER_FIRST_SEC'i de okur: ikisi aynı olmalı.
REMINDER_FIRST_SEC=180
REMINDER_EVERY_SEC=300
# `stand_nearby_drivers` yayın aralığı (sn).
NEARBY_EVERY_S=10
# Adayın konumu bu süreden eskiyse çağrı bildirilmez (ms).
LOCATION_FRESH_MS=30000
# Redis/PG uzlaştırıcısı: tarama aralığı, incelenecek en küçük ride yaşı ve sahipsiz kalmış kayıt yaşı (sn).
RECONCILE_EVERY_S=30
RECONCILE_MIN_AGE_S=30
RECONCILE_ORPHAN_AGE_S=60

# ===== Faz 5: push, hız sınırları, metrikler, kapanış =====
PUSH_ENABLED=true
# Expo erişim token'ı (isteğe bağlı)
EXPO_ACCESS_TOKEN=
PUSH_TTL_S=300
PUSH_RECEIPT_DELAY_S=900
# Hız sınırları; boşsa varsayılan (packages/shared RATE_LIMITS)
RATE_LIMIT_REST_IP_PER_MIN=600
RATE_LIMIT_REST_ACCOUNT_PER_MIN=240
RATE_LIMIT_PUSH_TOKEN_PER_10MIN=20
RATE_LIMIT_SOCKET_HANDSHAKE_IP_PER_MIN=60
RATE_LIMIT_RIDE_CREATE_PER_MIN=10
RATE_LIMIT_RIDE_ACCEPT_PER_MIN=30
RATE_LIMIT_RIDE_DECLINE_PER_MIN=60
RATE_LIMIT_RIDE_CANCEL_PER_MIN=30
RATE_LIMIT_RIDE_COMPLETE_PER_MIN=30
RATE_LIMIT_RIDE_DRIVER_CANCEL_PER_MIN=10
RATE_LIMIT_DRIVER_PRESENCE_PER_MIN=20
RATE_LIMIT_SESSION_SYNC_PER_MIN=20
RATE_LIMIT_AUTH_REFRESH_PER_MIN=10
# /metrics Bearer token'ı; üretimde tanımsızsa uç kapalıdır (404)
METRICS_TOKEN=
# Worker health/ready/metrics HTTP portu
WORKER_HTTP_PORT=9102
# API kapanışı: LB'nin çıkarması için bekleme ve zorla çıkış süresi (ms)
SHUTDOWN_DRAIN_MS=5000
SHUTDOWN_TIMEOUT_MS=15000

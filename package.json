{
  "name": "duraknet",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter @duraknet/driver-mobile lint && pnpm --filter @duraknet/stand-panel lint",
    "test": "pnpm -r test",
    "dev:api": "pnpm --filter @duraknet/api dev",
    "dev:worker": "pnpm --filter @duraknet/worker dev",
    "migrate": "node-pg-migrate -m migrations --migrations-table pgmigrations",
    "migrate:up": "pnpm migrate up",
    "migrate:down": "pnpm migrate down"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "node-pg-migrate": "^9.0.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
